# Copy these values into Streamlit Cloud → App settings → Secrets
# Do NOT commit real secrets to git.

DB_TYPE = "sqlite"
DB_NAME = "cv"

# Optional: remote MySQL (PlanetScale, Railway, etc.)
# DB_TYPE = "mysql"
# DB_HOST = "your-host.example.com"
# DB_PORT = 3306
# DB_USER = "your_user"
# DB_PASSWORD = "your_password"
# DB_NAME = "cv"

# Optional job APIs
JOOBLE_API_KEY = ""
ADZUNA_APP_ID = ""
ADZUNA_API_KEY = ""
ADZUNA_COUNTRY = "in"

# Ollama does not run on Streamlit Cloud — chat will stay disabled unless you use a remote host
# OLLAMA_HOST = "http://localhost:11434"
# OLLAMA_MODEL = "phi:latest"
